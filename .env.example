# Docker environment variables for Zabbix MCP Server and Open WebUI.
# Copy this file to .env and set the secret values.
#
# MCP_HOST - host interface to bind on the Docker host.
#   127.0.0.1  listen on localhost only (default, recommended)
#   0.0.0.0    listen on all interfaces
MCP_HOST=127.0.0.1

# MCP_PORT - port used inside the container and exposed on the Docker host.
# This overrides the 'port' setting in config.toml when running via Docker.
MCP_PORT=8080

# Bearer token shared by the MCP server and Open WebUI.
MCP_AUTH_TOKEN=replace-with-your-zmcp-token

# ADMIN_PORT - port for the admin web portal (default: 9090).
# Shares host and TLS settings with MCP server. Only port is separate.
ADMIN_PORT=9090

# Open WebUI (bound to localhost).
WEBUI_PORT=3000
WEBUI_SECRET_KEY=replace-with-a-long-random-secret

# Ollama running on the Windows host.
OLLAMA_BASE_URL=http://host.docker.internal:11434
